# ====================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Threat Intelligence Dashboard for Malicious IP & Domain Analysis
# ====================================================================

# DATABASE_URL: PostgreSQL Connection string (e.g. Neon Database)
# In local development without Postgres, the app automatically falls back
# to persistent local storage in ./data/threat_store.json.
# Example Neon connection:
DATABASE_URL="postgres://neondb_owner:YOUR_PASSWORD@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# LIVE THREAT INTELLIGENCE API KEYS (Kept securely on backend)
# 1. URLhaus (abuse.ch) Auth Key (Free Auth-Key at https://auth.abuse.ch/)
URLHAUS_API_KEY="YOUR_URLHAUS_API_KEY"

# 2. AbuseIPDB API Key (Free tier at https://www.abuseipdb.com/pricing)
ABUSEIPDB_API_KEY="YOUR_ABUSEIPDB_API_KEY"

# 3. AlienVault OTX API Key (Optional for public mode; free key at https://otx.alienvault.com/api)
OTX_API_KEY="YOUR_OTX_API_KEY"

# Server Port (Default is 3000)
PORT=3000

# App URL (Provided automatically by AI Studio or Vercel)
APP_URL="http://localhost:3000"

# Node Environment ('development' | 'production')
NODE_ENV="development"
